{
  "name": "babetbot",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "src/deploy.ts",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "start": "concurrently -k \"tsx watch --env-file=.env --env-file=.env.local src/start.ts\" \"stripe listen --forward-to localhost:8080/stripe/webhook --events checkout.session.completed\"",
    "deploy": "firebase deploy --only functions && tsx --env-file=.env src/deploy.ts --register"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.5",
    "@langchain/langgraph-checkpoint": "^1.1.2",
    "@langchain/openai": "^1.5.3",
    "@langchain/textsplitters": "^1.0.1",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "13",
    "firebase-functions": "^6.6.0",
    "langchain": "^1.5.2",
    "lodash": "^4.18.1",
    "openai": "^6.44.0",
    "pdf-parse": "^1.1.4",
    "stripe": "^22.3.0",
    "telegraf": "^4.16.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "concurrently": "^10.0.4",
    "eslint": "^8.57.1",
    "firebase-tools": "^14.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@browserbasehq/stagehand": {
      "dotenv": "$dotenv",
      "zod": "$zod",
      "openai": "$openai"
    },
    "dotenv": "$dotenv",
    "zod": "$zod",
    "openai": "$openai"
  },
  "resolutions": {
    "dotenv": "^17.4.2",
    "zod": "^4.4.3",
    "openai": "^6.44.0"
  }
}
