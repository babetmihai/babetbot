# -----------------------------------------------------------------------------
# Templates
# -----------------------------------------------------------------------------

# Optional; defaults to base. Use lawyers, psychologists, or base.
TEMPLATE_FOLDER=base

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

PORT=8080
NGROK_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------

# From @BotFather — enable Threaded Mode for provider case topics
TELEGRAM_BOT_TOKEN=

# Random string; sent as x-telegram-bot-api-secret-token on webhook requests
TELEGRAM_SECRET_TOKEN=

# -----------------------------------------------------------------------------
# Firm
# -----------------------------------------------------------------------------

# Comma-separated Telegram user ids for admin commands, FAQ uploads, and intake alerts
ADMIN_TELEGRAM_IDS=

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------

# Agent replies and RAG embeddings
OPENAI_API_KEY=

# Optional; defaults to gpt-4o-mini
AGENT_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Firebase / Firestore
# -----------------------------------------------------------------------------

# Firebase project id (Standard Firestore, Native mode)
FIREBASE_PROJECT_ID=

# Path to the Firebase Admin service-account JSON (relative to repo root or absolute)
GOOGLE_APPLICATION_CREDENTIALS=./your-project-firebase-adminsdk.json

# Stable user_id for firm FAQ documents in the documents collection
KB_USER_ID=firm

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local dev: set to 1 and run `npm run stripe` in a second terminal.
# Webhook secret: `stripe listen --print-secret`
STRIPE_DEV=1

# Amount in minor units (e.g. 15000 = 150.00)
INTAKE_FEE_AMOUNT_CENTS=15000

# Optional; defaults to ron
STRIPE_CURRENCY=ron
