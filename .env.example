# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

PORT=8080
NGROK_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------

# From @BotFather — enable Threaded Mode for lawyer case topics
TELEGRAM_BOT_TOKEN=

# Random string; sent as x-telegram-bot-api-secret-token on webhook requests
TELEGRAM_SECRET_TOKEN=

# -----------------------------------------------------------------------------
# Firm
# -----------------------------------------------------------------------------

# Comma-separated Telegram user ids for admin commands, FAQ uploads, and intake alerts
ADMIN_TELEGRAM_IDS=

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------

# Agent replies and RAG embeddings
OPENAI_API_KEY=

# Optional; defaults to gpt-4o-mini
AGENT_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------

# REST client for cases, goals, lawyers, and vector store
SUPABASE_URL=
SUPABASE_KEY=

# Direct Postgres connection string — LangGraph thread checkpointer (project settings → Database)
SUPABASE_POSTGRES_URL=

# Stable user_id for firm FAQ documents in the documents table
KB_USER_ID=firm

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local dev: set to 1 and run `npm run stripe:listen` in a second terminal.
# Webhook secret: `stripe listen --print-secret`
STRIPE_DEV=1

# Amount in minor units (e.g. 15000 = 150.00)
INTAKE_FEE_AMOUNT_CENTS=15000

# Optional; defaults to ron
STRIPE_CURRENCY=ron
